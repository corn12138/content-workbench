{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "内容工作台 Tauri",
  "version": "0.4.0",
  "identifier": "local.contentworkbench.tauri",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "内容工作台",
        "width": 1180,
        "height": 800,
        "minWidth": 800,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' ws://127.0.0.1:5173; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../third-party/": "legal/third-party/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGOEQ4OUIxMkQwQUE0QjYKUldTMnBBb3RzWW1OZjgrQzJoUTl2N1FJRDVvMHk2VGs1WExKUWo3ZUNoTXpLUVVRbnRwY1BCYWYK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/corn12138/content-workbench/releases/latest/download/latest.json"
      ]
    }
  }
}
